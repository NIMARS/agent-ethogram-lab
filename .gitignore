# Only the current PUBLIC_MANIFEST.md baseline is eligible for staging.
# New paths require a manifest update and a fresh publication review.
# Ignore rules do not approve publication or remove tracked/history content.
/*
!/.gitattributes
!/.gitignore
!/INDEPENDENT_DEVELOPMENT.md
!/PROJECT_SCOPE.md
!/PUBLIC_MANIFEST.md
!/README.md
!/docs/
/docs/*
!/docs/concept-note.md
!/docs/glossary.md
!/docs/public-roadmap.md
!/docs/research-questions.md
